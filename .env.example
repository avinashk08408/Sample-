# -----------------------------------------------------------------------------
# OMERTÀ 2K26 — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Google Sheets storage (service account) ---------------------------------
# 1) Google Cloud Console -> create a Service Account and download its JSON key.
# 2) Share your destination spreadsheet with the service account's email (Editor).
# GOOGLE_SERVICE_ACCOUNT_EMAIL="wh-omerta-2k26@your-project.iam.gserviceaccount.com"
# GOOGLE_PROJECT_ID="your-gcp-project-id"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
#   ^ The newline characters must stay escaped EXACTLY as above (paste the key
#     directly out of the JSON: "private_key").
# GOOGLE_SHEET_ID="1AbC...theLongIdFromTheSheetUrl..."

# --- Confirmation email (Gmail SMTP) -----------------------------------------
# Recommend an App Password created from Google account security settings.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your.gmail@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# MAIL_FROM="OMERTÀ 2K26 <your.gmail@gmail.com>"